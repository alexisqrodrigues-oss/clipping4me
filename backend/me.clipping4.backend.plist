<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>me.clipping4.backend</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/axis/Dev/clipping4melocal/backend/run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/axis/Dev/clipping4melocal/backend</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>CLIPPING4ME_ROOT</key>
    <string>/Users/axis/Dev/clipping4melocal/Documents</string>
    <!-- Defina ADMIN_BOOTSTRAP_PASSWORD apenas na PRIMEIRA execução,
         depois remova essa entrada e use o painel /admin pra trocar. -->
    <!--
    <key>ADMIN_BOOTSTRAP_PASSWORD</key>
    <string>troque-aqui</string>
    -->
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/axis/Library/Logs/clipping4me.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/axis/Library/Logs/clipping4me.err.log</string>
</dict>
</plist>