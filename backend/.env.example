# Copie para backend/.env e preencha os valores reais.
# O arquivo .env NUNCA vai pro git (está no .gitignore).

# Diarização (identifica quem fala). É OPCIONAL e exige:
# 1) pip install -r requirements-diarize.txt
# 2) HF_TOKEN abaixo
# 3) aceitar termos em huggingface.co/pyannote/{segmentation-3.0,speaker-diarization-3.1}
USE_WHISPERX=false

# Hugging Face — necessário para diarização do WhisperX (pyannote).
# Pegue em: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DIARIZE_MIN_SPEAKERS=1
DIARIZE_MAX_SPEAKERS=6

# Ollama (rodando local no Mac via `ollama serve`)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL_COPY=llama3.1:8b
OLLAMA_MODEL_ANALYSIS=qwen2.5:7b

# WhisperX
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto         # auto | cpu | mps | cuda
WHISPER_LANGUAGE=pt

# Idioma padrão das copies geradas
COPY_LANGUAGE=pt-BR

# Backend HTTP
HOST=127.0.0.1
PORT=8765

# Pasta onde os jobs/clipes/exports são salvos
DATA_DIR=./data