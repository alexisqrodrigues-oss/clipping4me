# Copie para backend/.env e preencha o que quiser sobrescrever.
# O arquivo .env NUNCA vai pro git (está no .gitignore).
# Tudo aqui é OPCIONAL — os defaults do código já funcionam.

# ---------- Admin inicial ----------
# Na primeira execução o backend cria o usuário admin.
# Se você não passar a senha, uma aleatória é gerada e impressa UMA vez no log.
ADMIN_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=TrocarEssaSenha123

# ---------- Backend HTTP ----------
# Porta lida pelo run.sh / LaunchAgent.
CLIPPING4ME_BACKEND_PORT=8765

# Pasta raiz onde Jobs/, Cortes/, Cache/, jobs.json e media/ são salvos.
CLIPPING4ME_ROOT=~/Clipping4me

# Frontend autorizado no CORS (além de localhost dev).
FRONTEND_URL=https://clipping4.me

# ---------- Ollama (rodando local via `ollama serve` ou `brew services start ollama`) ----------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ---------- Whisper ----------
WHISPER_MODEL=small         # tiny | base | small | medium | large
WHISPER_DEVICE=auto         # auto | cpu | mps | cuda
WHISPER_LANGUAGE=pt

# ---------- Cortes ----------
MAX_CLIPS=8
CLIP_MIN_SEC=30
CLIP_MAX_SEC=90

# ---------- Diarização (identifica quem fala) ----------
# As dependências já são instaladas por padrão.
# Se HF_TOKEN estiver preenchido, a diarização liga automaticamente.
# USE_WHISPERX só é necessário para forçar desligado/ligado manualmente.
# Aceite os termos em
#    https://huggingface.co/pyannote/segmentation-3.0
#    https://huggingface.co/pyannote/speaker-diarization-3.1
# e preencha HF_TOKEN (https://huggingface.co/settings/tokens)
# USE_WHISPERX=true
# USE_WHISPERX=false
HF_TOKEN=
DIARIZE_MIN_SPEAKERS=1
DIARIZE_MAX_SPEAKERS=6